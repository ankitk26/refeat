{
	"name": "refeat",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "pnpm -r --parallel dev",
		"build": "pnpm -r --if-present build",
		"check-types": "pnpm -r check-types",
		"dev:web": "pnpm --filter web dev",
		"dev:server": "pnpm --filter @refeat/backend dev",
		"dev:setup": "pnpm --filter @refeat/backend dev:setup",
		"check": "oxlint && oxfmt --write",
		"fmt": "oxfmt --write",
		"deploy": "pnpm --filter @refeat/backend deploy:convex && pnpm --filter web deploy:cf"
	},
	"dependencies": {
		"@refeat/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@oxlint/plugins": "1.80.0",
		"@refeat/config": "workspace:*",
		"@types/node": "catalog:",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.80.0",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@10.26.0",
	"pnpm": {
		"onlyBuiltDependencies": [
			"@cloudflare/workerd-windows-64",
			"esbuild",
			"workerd"
		]
	}
}
